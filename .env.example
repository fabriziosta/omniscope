# Local Omniscope secrets (copy to `.env` and fill in).
# Never commit `.env` — it is gitignored.
#
# Dual sync: Flutter suggests these in Agents / Settings. UI saves write into
# omniscope.json plus back here when running from a project checkout (desktop).
# On startup, non-empty values here are promoted into omniscope.json when that
# key is missing/empty there. Web / mobile use the config blob only.
# See tool/flutter_checks.sh. Python: `set -a; source .env; set +a`.
#
# ---------------------------------------------------------------------------
# LLM providers — suggest in Agents → Connect
# (ids match LlmProvider: openAi → OPENAI, deepSeek → DEEPSEEK)
# ---------------------------------------------------------------------------

OMNISCOPE_GEMINI_API_KEY=
OMNISCOPE_OPENAI_API_KEY=
OMNISCOPE_ANTHROPIC_API_KEY=
OMNISCOPE_DEEPSEEK_API_KEY=
OMNISCOPE_GROK_API_KEY=
OMNISCOPE_CUSTOM_API_KEY=

# Optional fallback for Python CLI when a provider-specific key is unset.
# OMNISCOPE_API_KEY=

# ---------------------------------------------------------------------------
# Exchanges / markets — OMNISCOPE_<EXCHANGE_ID>_API_{KEY|SECRET|TOKEN}
# Exchange id is the venue machine id (crypto_com → CRYPTO_COM).
# Public market data works without these; keys enable authenticated APIs.
# Crypto.com is also editable under Settings → Crypto exchanges → Configure.
# ---------------------------------------------------------------------------

# Crypto.com Exchange (https://api.crypto.com/exchange/v1/)
OMNISCOPE_CRYPTO_COM_API_KEY=
OMNISCOPE_CRYPTO_COM_API_SECRET=
OMNISCOPE_CRYPTO_COM_API_TOKEN=

# Alpaca (https://docs.alpaca.markets/) — stocks/ETFs paper or live
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview
# TRADING_MODE: paper (default) or live — must match the key environment
OMNISCOPE_ALPACA_API_KEY=
OMNISCOPE_ALPACA_API_SECRET=
OMNISCOPE_ALPACA_TRADING_MODE=paper

# Yahoo Finance chart API is keyless today — no vars required.
